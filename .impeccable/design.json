      "html": "<button class=\"ds-small\">Exporter</button>",
      "css": ".ds-small{font-family:var(--font-marr-sans,system-ui),sans-serif;font-size:13px;line-height:1.35;font-weight:600;display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:6px 10px;border:1px solid var(--blm-line,#d7dce2);border-radius:4px;background:var(--blm-bg,#fff);color:var(--blm-fg,#263244);cursor:pointer}.ds-small:hover{background:var(--blm-panel,#f5f6f8)}.ds-small:focus-visible{outline:3px solid var(--blm-ring,#086bb7);outline-offset:3px}.ds-small:disabled{cursor:wait;opacity:.6}"
