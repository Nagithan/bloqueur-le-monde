    {
      "name": "Bouton principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Confirmer une action ou ajouter un auteur.",
      "html": "<button class=\"ds-primary\">Masquer</button>",
      "css": ".ds-primary{font-family:var(--font-marr-sans,system-ui),sans-serif;font-size:16px;font-weight:600;line-height:1.35;display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:9px 15px;border:1px solid var(--blm-line,#d7dce2);border-radius:4px;cursor:pointer;background:var(--blm-button,#263b56);border-color:var(--blm-button,#263b56);color:var(--blm-on-button,#fff)}.ds-primary:hover{filter:brightness(.93)}.ds-primary:focus-visible{outline:3px solid var(--blm-ring,#086bb7);outline-offset:3px;}.ds-primary:disabled{cursor:wait;opacity:.6}"
    },
    {
      "name": "Bouton secondaire",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Annuler ou agir sans renforcer la priorité visuelle.",
      "html": "<button class=\"ds-secondary\">Annuler</button>",
      "css": ".ds-secondary{font-family:var(--font-marr-sans,system-ui),sans-serif;font-size:16px;font-weight:600;line-height:1.35;display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:9px 15px;border:1px solid var(--blm-line,#d7dce2);border-radius:4px;cursor:pointer;background:var(--blm-bg,#fff);color:var(--blm-fg,#263244)}.ds-secondary:hover{background:var(--blm-panel,#f5f6f8)}.ds-secondary:focus-visible{outline:3px solid var(--blm-ring,#086bb7);outline-offset:3px;}.ds-secondary:disabled{cursor:wait;opacity:.6}"
    },
